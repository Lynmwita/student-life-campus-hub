# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Service role key for admin/CLI operations (DO NOT expose in client code)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Config
NEXT_PUBLIC_APP_NAME="Student Life & Campus Hub"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_DEMO_AUTH=false

# Cron Automation & UAMS Auto-Sync Secrets
CRON_SECRET=your-256-bit-random-cron-secret-token
UAMS_SYNC_SECRET=your-256-bit-random-uams-sync-secret

# Explicit Hub tenant UUID; required for durable institutional imports.
UAMS_SYNC_UNIVERSITY_ID=your-hub-university-uuid
# Full institutional feed: students, courses, timetables, grades, dates and notices.
UAMS_API_URL=https://your-uams-domain/api/v1/integrations/hub
UAMS_API_KEY=your-at-least-32-character-feed-secret
# Optional supplementary source; leave empty when using the full feed above.
UAMS_ANNOUNCEMENTS_API_URL=
# Must match UAMS UAMS_FEED_SECRET. Server only.
UAMS_ANNOUNCEMENTS_API_KEY=your-at-least-32-character-feed-secret
UAMS_SUPPORT_API_URL=https://your-uams-domain/api/v1/integrations/hub/support
HUB_SYNC_API_KEY=your-separate-at-least-32-character-support-secret

# Browser push: public key included at build time; private key stays server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:campus-support@your-institution.example

# Staging/Production PostgreSQL Connection Pooler (Server Only)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
