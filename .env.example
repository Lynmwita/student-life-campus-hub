# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Service role key for admin/CLI operations (DO NOT expose in client code)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Config
NEXT_PUBLIC_APP_NAME="Student Life & Campus Hub"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_DEMO_AUTH=false

# Cron Automation & UAMS Auto-Sync Secrets
CRON_SECRET=your-256-bit-random-cron-secret-token
UAMS_SYNC_SECRET=your-256-bit-random-uams-sync-secret

# Staging/Production PostgreSQL Connection Pooler (Server Only)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
